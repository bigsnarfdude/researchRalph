# Worktrees (created at runtime)
worktrees/

# Results (collected separately)
results/

# Runtime artifacts
*.log
run.log
agent.log
result.json
*.pyc
__pycache__/

# Per-run experiment output inside domains/. The harness regenerates all of it.
# Domain scaffolding stays tracked — run.sh, program.md, program_static.md,
# config.yaml, results.tsv, blackboard.md, and the DESIRES/MISTAKES/LEARNINGS
# telemetry are the experiment record and belong in git.
#
# NOTE: ~4.8k files under these paths were committed before this rule existed and
# remain tracked; .gitignore does not untrack them. This stops the pile growing.
# Untracking the historical ones is a separate, deliberate decision.
# ** rather than * — some domains nest runs one level deeper
# (e.g. gemma4-april3/experiments/<run>/workspace/).
domains/**/logs/
domains/**/workspace/
domains/**/.agent_prompts/
domains/**/queue/
domains/**/active/
domains/**/done/
**/.nudge_data.json

# Ad-hoc analysis output at the repo root. The scripts that produce it are
# trackable; the regenerable CSV/JSON they emit is not.
gemma3_v_paradox_results*.csv
gemma3_v_paradox_results*.json

# Editor
.DS_Store
.vscode/
.idea/

# Conductor state
.conductor/

# v5 guard / loop transient state (never commit run scratch)
**/GUARD_HALT
**/.oracle_hash
**/.mock_calls
**/.distill_at_rows
**/runs/
v5/cost_ledger.tsv
v5/.test_ledger.tsv
v5/.live_ledger.tsv

# Agent scratch (created at runtime in worktrees)
memory/
scratch/

# Python
.venv/
*.egg-info/
dist/
build/
sft_data/attempts_*
sft_data/*.tar.gz
sft_data/*.jsonl
sft_data/*.tsv
sft_data/*.md
# model artifacts — never in git (62GB incident, June 2026)
domains/rrma-r1/checkpoints/
domains/rrma-r1/best/
*.npz
*.pt
*.safetensors
*.ckpt
